---
import Container from "../../shared/Container.astro";
import GradiantText from "../../shared/GradiantText.astro";
import LazyImage from "../../shared/LazyImage.astro";
import Paragraph from "../../shared/Paragraph.astro";
import SubTitle2 from "../../shared/SubTitle2.astro";
import Title2 from "../../shared/Title2.astro";
import Title3 from "../../shared/Title3.astro";
import { innovationsSection } from "./data.ts";

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section id="innovations" class=`${className}`>
  <Container
    className="mx-auto flex flex-col items-center justify-center text-center"
    data-reveal
  >
    <Title2>{innovationsSection.title}</Title2>
    <SubTitle2>
      {innovationsSection.subheading1_1}<br />
      <GradiantText>{innovationsSection.subheading1_2}</GradiantText>
    </SubTitle2>
  </Container>
  <Container>
    {
      innovationsSection.innovations.map((solution, index: number) => {
        // Even rows put the image on the right. Both halves hug the centre line so
        // every image/text pair has the same gap and the text centres on its image.
        const imageRight = index % 2 === 0;
        return (
          <div class="pb-16 md:pb-20 last:pb-0">
            <div
              class={`flex flex-col items-center gap-10 midmd:gap-16 ${imageRight ? "midmd:flex-row-reverse" : "midmd:flex-row"} mx-auto max-w-6xl w-full`}
            >
              <div
                data-reveal={imageRight ? "right" : "left"}
                class={`flex w-11/12 midmd:w-1/2 justify-center ${imageRight ? "midmd:justify-start" : "midmd:justify-end"}`}
              >
                <div class="group w-full max-w-md lg:max-w-[500px] aspect-square relative overflow-hidden rounded-3xl">
                  <LazyImage
                    src={solution.visual}
                    alt={solution.alt}
                    width="500"
                    class="w-full h-full rounded-3xl object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                </div>
              </div>
              <div
                data-reveal
                class={`flex w-11/12 midmd:w-1/2 justify-center ${imageRight ? "midmd:justify-end" : "midmd:justify-start"}`}
              >
                <div class="max-w-md">
                  <Title3>{solution.title}</Title3>
                  <Paragraph className="mt-3">{solution.description}</Paragraph>
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </Container>
</section>
