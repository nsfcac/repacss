---
import { getImage, Picture } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/Container.astro";
import { getAlbums, type Album } from "../../utils/gallery";

export function getStaticPaths() {
  return getAlbums().map((album) => ({ params: { group: album.name }, props: { album } }));
}

const { album } = Astro.props as { album: Album };
const { title, description } = album;

// Large version for the full-screen viewer; the grid uses smaller thumbnails.
const photos = await Promise.all(
  album.photos.map(async (src) => ({
    src,
    full: (await getImage({ src, width: Math.min(src.width, 1800), format: "webp" })).src,
  })),
);
---
<Layout title={`${title} | Gallery`} description={description || `Photos from ${title} at REPACSS.`}>
  <main class="overflow-hidden pt-24 md:pt-32 px-4 md:px-8">
    <Container className="mx-auto flex flex-col gap-6">
      <div>
        <a href="/gallery" class="text-sm text-primary hover:underline">&larr; Gallery</a>
        <h1 class="mt-2 text-2xl font-semibold text-gray-800 dark:text-gray-200">{title}</h1>
        {description && <p class="text-lg text-gray-600 dark:text-gray-400">{description}</p>}
      </div>
      <div class="masonry">
        {photos.map((photo, i) => (
          <button
            type="button"
            data-reveal
            data-full={photo.full}
            data-index={i}
            aria-label={`View photo ${i + 1} of ${photos.length} full screen`}
            class="masonry-item group block w-full mb-4 break-inside-avoid overflow-hidden rounded-lg shadow-lg cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <Picture
              src={photo.src}
              alt={`Photo ${i + 1} from ${title}`}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 400px, (min-width: 600px) 50vw, 100vw"
              formats={["webp"]}
              fallbackFormat="webp"
              class="w-full h-auto transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </button>
        ))}
      </div>
    </Container>
  </main>

  <!-- Full-screen viewer. <dialog> gives Escape-to-close and focus handling for free. -->
  <dialog
    id="lightbox"
    aria-label={`${title} photo viewer`}
    class="m-auto max-w-none max-h-none w-screen h-screen bg-transparent p-0 backdrop:bg-black/90"
  >
    <div class="relative flex h-full w-full items-center justify-center p-4 sm:p-12">
      <img id="lightbox-img" alt="" class="max-h-full max-w-full rounded-md object-contain shadow-2xl" />
      <p id="lightbox-count" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-white/80"></p>
      <button type="button" data-lb="close" aria-label="Close" class="absolute top-3 right-3 rounded-full p-2 text-white/80 hover:bg-white/10 hover:text-white">
        <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <button type="button" data-lb="prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full p-2 text-white/80 hover:bg-white/10 hover:text-white">
        <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" data-lb="next" aria-label="Next photo" class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full p-2 text-white/80 hover:bg-white/10 hover:text-white">
        <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </dialog>
</Layout>

<script>
  import { event } from '../../utils/analytics.ts';

  const galleryName = window.location.pathname.split('/').pop() || 'unknown_gallery';
  event({ action: 'view_gallery_detail', category: 'gallery', label: galleryName });

  const items = [...document.querySelectorAll<HTMLButtonElement>('.masonry-item')];
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const count = document.getElementById('lightbox-count')!;
  let current = 0;

  function show(i: number) {
    current = (i + items.length) % items.length;
    img.src = items[current].dataset.full!;
    img.alt = items[current].querySelector('img')?.alt ?? '';
    count.textContent = `${current + 1} / ${items.length}`;
  }

  items.forEach((item, i) =>
    item.addEventListener('click', () => {
      show(i);
      dialog.showModal();
      event({ action: 'click_gallery_image', category: 'gallery', label: `${galleryName}_image_${i + 1}` });
    }),
  );

  dialog.addEventListener('click', (e) => {
    const action = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (action === 'prev') show(current - 1);
    else if (action === 'next') show(current + 1);
    // Close on the close button or a click on the dark area around the photo.
    else if (action === 'close' || e.target !== img) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  dialog.addEventListener('close', () => items[current]?.focus());
</script>
