---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import { getAlbums } from "../utils/gallery";

const groups = getAlbums();
---


  <Layout title="Gallery" description="Photos from building REPACSS, from site preparation and equipment delivery to rack assembly and enclosure installation.">
    <main class="flex flex-col overflow-hidden pt-24 md:pt-32 px-4 md:px-8">
      <Container className="mx-auto flex flex-col gap-8">
        <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-200">Gallery</h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {groups.map(group => (
            <a href={`/gallery/${group.name}`} data-reveal class="group lift relative flex flex-col overflow-hidden rounded-lg shadow-lg">
              <div class="cover-container relative overflow-hidden">
                <Picture
                  src={group.cover}
                  alt={`Cover of ${group.title}`}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1280px) 620px, (min-width: 640px) 50vw, 100vw"
                  formats={["webp"]}
                  fallbackFormat="webp"
                  class="w-full aspect-[3/2] object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex-1 p-4 text-left bg-white dark:bg-gray-800">
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-200 group-hover:text-primary">{group.title}</h2>
                <p class="text-sm text-gray-600 dark:text-gray-400">{group.description}</p>
              </div>
            </a>
          ))}
        </div>
      </Container>
  </main>
  </Layout>

<script>
  import { event } from '../utils/analytics.ts';
  
  // Track gallery group clicks
  document.querySelectorAll('a[href^="/gallery/"]').forEach(link => {
    link.addEventListener('click', () => {
      const galleryName = link.getAttribute('href')?.split('/').pop() || 'unknown';
      event({
        action: 'view_gallery_group',
        category: 'gallery',
        label: galleryName,
      });
    });
  });
</script>

